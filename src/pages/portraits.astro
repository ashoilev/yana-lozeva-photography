---
import MainLayout from "../layouts/MainLayout.astro";
import CTA from "../components/CTA.astro";
import EditorialGallery from "../components/EditorialGallery.astro";
import PageHero from "../components/PageHero.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import { personalImages, withBase } from "../data/site";
---

<MainLayout
  title="Portraits | Yana Lozeva"
  description="Personal portrait photography in Sofia for individuals, couples, families and children."
>
  <PageHero
    eyebrow="Portraits"
    title="People, Properly Photographed"
    intro="A portrait session can be quiet, direct and surprisingly easy. You do not need to arrive knowing how to stand, look or perform."
  />

  <EditorialGallery items={personalImages} />

  <section class="content-band">
    <div class="container service-grid">
      <div>
        <p class="eyebrow">Private Sessions</p>
      </div>
      <ServiceBlock
        services={[
          {
            eyebrow: "01",
            title: "Individual Portraits",
            body: "For people who need a photograph that feels direct and alive, without becoming overly polished."
          },
          {
            eyebrow: "02",
            title: "Couples",
            body: "Photographs with closeness and restraint, made without turning the session into a performance."
          },
          {
            eyebrow: "03",
            title: "Families",
            body: "Simple portraits of family life, with space for movement, quietness and the relationships already there."
          },
          {
            eyebrow: "04",
            title: "Children",
            body: "Patient, unfussy sessions for children, led by attention rather than forced smiles."
          }
        ]}
      />
    </div>
  </section>

  <CTA
    eyebrow="Booking"
    title="Want your own?"
    body="You do not need to know how to pose. Yana will guide the session without making it feel staged."
    primaryLabel="Book a portrait"
    primaryHref={withBase("/#book")}
  />
</MainLayout>
