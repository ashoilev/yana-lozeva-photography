---
import MainLayout from "../layouts/MainLayout.astro";
import CTA from "../components/CTA.astro";
import PageHero from "../components/PageHero.astro";
import { images, site } from "../data/site";
---

<MainLayout
  title="About | Yana Lozeva"
  description="About Yana Lozeva, a Sofia-based photographer working with people throughout Bulgaria."
>
  <PageHero
    eyebrow="About"
    title="Yana Lozeva"
    intro="A photographer based in Sofia, Bulgaria, available for work throughout Bulgaria."
    image={images.hero}
    portraitLayout={true}
  />

  <section class="content-band">
    <div class="container text-grid">
      <p class="eyebrow">Approach</p>
      <div class="text-stack">
        <p>Yana Lozeva is a Sofia-based photographer working with people, individually, together and at work.</p>
        <p>Her approach is direct, relaxed and editorial, with black and white forming an important part of her visual language. She often works on film, while moving freely between film and digital photography.</p>
        <p>Yana has a particular ability to make people who feel uncomfortable in front of a camera feel at ease. Her sessions are friendly, open and unforced.</p>
        <p>She photographs individuals, couples, families, children, employees and teams in Sofia and throughout Bulgaria.</p>
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Contact"
    title="Start with a simple note"
    body="Tell Yana what kind of portrait you need, where you are based and when you have in mind."
    primaryLabel="Book a portrait"
    primaryHref="/#book"
    secondaryLabel="Email Yana"
    secondaryHref={`mailto:${site.email}`}
  />
</MainLayout>
