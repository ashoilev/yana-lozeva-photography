---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<MainLayout
  title="Contact & Booking | Yana Lozeva"
  description="Book a personal portrait session or contact Yana Lozeva about corporate portraits and team photography."
>
  <PageHero
    eyebrow="Contact"
    title="Booking"
    intro="Personal portraits are booked through Calendly. Company shoots begin with a short email to Yana."
  />

  <section id="book" class="content-band">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Book a portrait</p>
      </div>
      <div class="text-stack">
        <p>Personal portrait sessions are booked directly through Yana's Calendly.</p>
        <ul class="booking-list" aria-label="Personal portrait booking options">
          <li>
            <a href={site.calendly.url}>
              <span>Portrait booking</span>
              <span>Calendly</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="content-band">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Company enquiries</p>
      </div>
      <form class="contact-form" action={`mailto:${site.email}`} method="post" enctype="text/plain">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="Name" autocomplete="name" />
        </div>
        <div class="field">
          <label for="company">Company</label>
          <input id="company" name="Company" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="Email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="message">What do you have in mind?</label>
          <textarea id="message" name="Message"></textarea>
        </div>
        <button class="button" type="submit">Plan a company shoot</button>
        <p>Or email directly: <a class="plain-link" href={`mailto:${site.email}?subject=Company photography enquiry`}>{site.email}</a></p>
      </form>
    </div>
  </section>
</MainLayout>
