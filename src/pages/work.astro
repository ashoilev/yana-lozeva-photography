---
import MainLayout from "../layouts/MainLayout.astro";
import { workImages } from "../data/site";
---

<MainLayout
  title="Work | Yana Lozeva"
  description="An expansive selection of portrait photography by Sofia-based photographer Yana Lozeva."
>
  <header class="work-page-intro">
    <p class="eyebrow">Selected archive</p>
    <h1>Work</h1>
  </header>

  <section class="work-wall" aria-label="Photography by Yana Lozeva">
    {
      workImages.map((image, index) => (
        <figure class="work-wall-item">
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading={index < 8 ? "eager" : "lazy"}
            decoding={index < 4 ? "sync" : "async"}
            fetchpriority={index < 4 ? "high" : "auto"}
            sizes="(max-width: 540px) 50vw, (max-width: 900px) 33vw, 25vw"
          />
        </figure>
      ))
    }
  </section>
</MainLayout>
