---
import MainLayout from "../layouts/MainLayout.astro";
import HomeGallery from "../components/HomeGallery.astro";
import {
  corporateImages,
  homepageImages,
  personalImages,
  site,
  withBase
} from "../data/site";

const personalPreview = personalImages.slice(0, 4);
const corporatePreview = corporateImages.slice(0, 4);
const corporateMailto = `mailto:${site.email}?subject=${encodeURIComponent("Corporate photography inquiry")}&body=${encodeURIComponent("Hello Yana,\n\nI would like to inquire about corporate portraits / team photography.\n\nName:\nCompany:\nWhat we have in mind:\n")}`;
---

<MainLayout
  title="Yana Lozeva | Portrait Photographer in Sofia"
  description="Yana Lozeva creates intimate, editorial portraits of people individually, together and at work. Based in Sofia and available throughout Bulgaria."
>
  <HomeGallery images={homepageImages} />

  <section class="intro-line intro-yana" aria-labelledby="about-yana">
    <div class="container intro-yana-grid">
      <div>
        <p class="eyebrow">Yana Lozeva</p>
        <h1 id="about-yana">Photographer, Sofia</h1>
      </div>
      <div class="text-stack">
        <p>Yana photographs people individually, together and at work.</p>
        <p>Her approach is relaxed and direct, especially for people who do not naturally feel comfortable in front of a camera. Black and white is part of her visual signature, and she frequently works with film.</p>
        <p>Based in Sofia. Available throughout Bulgaria.</p>
        <a class="text-link" href={withBase("/about")}>More about Yana</a>
      </div>
    </div>
  </section>

  <section id="work" class="work-section" aria-label="Portrait services">
    <div class="container work-paths">
      <article class="work-path" id="personal">
        <div class="work-path-copy">
          <p class="label">Personal portraits</p>
          <h3>Individuals, couples, families, children</h3>
          <p>You do not need to know how to pose or arrive comfortable in front of the camera. Yana handles that part, keeping the session simple, calm and specific to you.</p>
          <div class="work-actions">
            <a class="button" href="#book">Book a portrait</a>
          </div>
        </div>
        <div class="inline-portfolio" aria-label="Personal portrait examples">
          {
            personalPreview.map((image) => (
              <figure class={image.orientation}>
                <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
              </figure>
            ))
          }
        </div>
      </article>

      <article class="work-path" id="companies">
        <div class="work-path-copy">
          <p class="label">For companies</p>
          <h3>Employee portraits, headshots, team portraits</h3>
          <p>Company photography can look professional without flattening everyone into the same expression. Yana builds consistency while leaving room for actual character.</p>
          <div class="work-actions">
            <a class="button secondary" href={corporateMailto}>Make an inquiry</a>
          </div>
        </div>
        <div class="inline-portfolio" aria-label="Company portrait examples">
          {
            corporatePreview.map((image) => (
              <figure class={image.orientation}>
                <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
              </figure>
            ))
          }
        </div>
      </article>
    </div>
    <div class="container work-archive-link">
      <a class="button" href={withBase("/work")}>View all work</a>
    </div>
  </section>

  <section id="book" class="booking-embed" aria-labelledby="book-title">
    <div class="container booking-embed-grid">
      <div>
        <p class="eyebrow">Book a portrait</p>
        <h2 id="book-title">Choose a time with Yana</h2>
      </div>
      <div>
        <p>Personal portrait sessions are booked directly through Calendly. For company work, use the inquiry link above instead.</p>
        <div class="calendly-frame">
          <div class="calendly-inline-widget" data-url={site.calendly.url}></div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
</MainLayout>
