---
import MainLayout from "../../layouts/MainLayout.astro";
import CTA from "../../components/CTA.astro";
import EditorialGallery from "../../components/EditorialGallery.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceBlock from "../../components/ServiceBlock.astro";
import { copy, languages, type Language } from "../../data/i18n";
import { corporateImages, site } from "../../data/site";

export const getStaticPaths = () => languages.map((lang) => ({ params: { lang }, props: { lang } }));
const { lang } = Astro.props as { lang: Language };
const text = copy[lang].companies;
const services = text.services.map((service, index) => ({ eyebrow: String(index + 1).padStart(2, "0"), ...service }));
---

<MainLayout title={text.title} description={text.description} lang={lang} page="companies">
  <PageHero eyebrow={text.label} title={text.h1} intro={text.intro} />
  <EditorialGallery items={corporateImages} lang={lang} label={text.label} />
  <section class="content-band"><div class="container service-grid"><div><p class="eyebrow">{text.offer}</p></div><ServiceBlock services={services} /></div></section>
  <section class="content-band">
    <div class="container"><div class="text-grid"><p class="eyebrow">{text.process}</p><div><p class="page-intro">{text.processIntro}</p><div class="process">
      {text.steps.map((step) => <article class="process-step"><p class="label">{step.label}</p><h2>{step.title}</h2><p>{step.body}</p></article>)}
    </div></div></div></div>
  </section>
  <CTA eyebrow={text.cta.label} title={text.cta.title} body={text.cta.body} primaryLabel={text.cta.action} primaryHref={`mailto:${site.email}?subject=${encodeURIComponent(text.cta.subject)}`} />
</MainLayout>
