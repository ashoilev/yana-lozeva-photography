---
import { getCopy, localizedPath, type Language, type PageKey } from "../data/i18n";
import { logo } from "../data/site";

type Props = { lang: Language; page: PageKey; alternateUrl: string };
const { lang, page, alternateUrl } = Astro.props;
const text = getCopy(lang);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-mark" href={localizedPath(lang)} aria-label={lang === "bg" ? "Начална страница на Яна Лозева" : "Yana Lozeva home"}>
      <img src={logo.src} alt="" width="240" height="240" />
      <span class="site-credit"><span class="site-name">Yana Lozeva</span></span>
    </a>
    <nav aria-label={lang === "bg" ? "Основна навигация" : "Primary navigation"}>
      <ul class="nav-list">
        <li><a class:list={["nav-link", { "nav-link-active": page === "portraits" }]} href={localizedPath(lang, "portraits")}><span class="nav-label-full">{text.nav.personal}</span><span class="nav-label-short">{text.nav.personalShort}</span></a></li>
        <li><a class:list={["nav-link", { "nav-link-active": page === "companies" }]} href={localizedPath(lang, "companies")}><span class="nav-label-full">{text.nav.companies}</span><span class="nav-label-short">{text.nav.companiesShort}</span></a></li>
        <li><a class:list={["nav-link", { "nav-link-active": page === "giftVouchers" }]} href={localizedPath(lang, "giftVouchers")}>{text.nav.giftVouchers}</a></li>
        <li><a class="nav-link lang-link" href={alternateUrl} hreflang={lang === "en" ? "bg" : "en"} lang={lang === "en" ? "bg" : "en"} aria-label={lang === "en" ? "Български" : "English"}>{text.nav.language}</a></li>
        <li><a class="book-link" href={localizedPath(lang, "home", "#book")}>{text.nav.book}</a></li>
      </ul>
    </nav>
  </div>
</header>
