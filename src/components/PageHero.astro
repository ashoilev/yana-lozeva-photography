---
type Props = {
  eyebrow: string;
  title: string;
  intro: string;
  quote?: string;
  image?: {
    src: string;
    alt: string;
  };
  portraitLayout?: boolean;
  hideTitle?: boolean;
};

const { eyebrow, title, intro, quote, image, portraitLayout = false, hideTitle = false } = Astro.props;
---

<section class="page-hero">
  <div class:list={["container", "page-hero-grid", { "portrait-layout": portraitLayout, "title-hidden": hideTitle && !portraitLayout }]}>
    {portraitLayout ? (
      <>
        <div class="page-hero-heading">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="page-title">{title}</h1>
        </div>
        {image && (
          <figure class="about-portrait">
            <img src={image.src} alt={image.alt} width="1024" height="1024" loading="eager" decoding="async" />
          </figure>
        )}
        <p class="page-intro">{intro}</p>
      </>
    ) : (
      <>
        <div>
          <p class="eyebrow">{eyebrow}</p>
          {hideTitle ? (
            <>
              <h1 class="visually-hidden">{title}</h1>
              <div class="page-title page-title-placeholder" aria-hidden="true"></div>
            </>
          ) : (
            <h1 class="page-title">{title}</h1>
          )}
        </div>
        <div>
          <p class="page-intro">{intro}</p>
          {quote && <p class="page-hero-quote">{quote}</p>}
        </div>
      </>
    )}
  </div>
</section>
