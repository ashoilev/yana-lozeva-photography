---
import type { PortfolioImage } from "../data/site";

type Props = {
  items: PortfolioImage[];
};

const { items } = Astro.props;
---

<section class="container editorial-gallery" aria-label="Selected photography">
  {
    items.map((item, index) => (
      <figure class:list={["gallery-item", item.orientation]}>
        <img
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading={index < 6 ? "eager" : "lazy"}
          decoding="async"
          sizes="(max-width: 680px) 50vw, (max-width: 980px) 33vw, 25vw"
        />
      </figure>
    ))
  }
</section>
