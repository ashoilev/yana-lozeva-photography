---
import type { PortfolioImage } from "../data/site";
import type { Language } from "../data/i18n";

type Props = {
  items: PortfolioImage[];
  lang: Language;
  label: string;
};

const { items, lang, label } = Astro.props;
const trailingItems = (columns: number) => items.length % columns;
const hiddenFrom = (columns: number) => items.length - trailingItems(columns);
---

<section class="container editorial-gallery" aria-label={label}>
  {
    items.map((item, index) => (
      <figure class:list={[
        "gallery-item",
        item.orientation,
        { "gallery-hide-desktop": trailingItems(4) > 0 && index >= hiddenFrom(4) },
        { "gallery-hide-tablet": trailingItems(3) > 0 && index >= hiddenFrom(3) },
        { "gallery-hide-mobile": trailingItems(2) > 0 && index >= hiddenFrom(2) }
      ]}>
        <img
          src={item.src}
          alt={lang === "bg" ? item.altBg : item.alt}
          width={item.width}
          height={item.height}
          loading={index < 6 ? "eager" : "lazy"}
          decoding="async"
          sizes="(max-width: 680px) 50vw, (max-width: 980px) 33vw, 25vw"
        />
      </figure>
    ))
  }
</section>
